result
result-*

# cache
.evalcache/*
# direnv
.direnv/
.envrc.local

# secrets — never commit real values
secrets.nix
secrets/
*.pem
*.key
.env
.env.local

# pi mesh extension runtime state (ledger + per-session identities)
.mesh/

# editor/backup cruft
*.bak
*.midpoint.bak
*~
*.orig
